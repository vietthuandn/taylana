# Sao chép thành .env.local khi chạy trên máy (npm run dev)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Địa chỉ web (không có / ở cuối)
NEXT_PUBLIC_SITE_URL=https://taylana-print.vercel.app

# Cloudflare R2 (lưu file) — key bí mật chỉ dùng phía server
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=taylana-public
R2_PRIVATE_BUCKET=taylana-private
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# STORAGE_PROVIDER=supabase  (quay lại Supabase Storage)
